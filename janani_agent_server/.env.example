# =========================================================
# Janani Strands Agent Server - Environment Configuration
# =========================================================

# ── Model Provider ─────────────────────────────────────────
# 'ollama'  = fully local, FREE, no account needed (DEFAULT)
# 'bedrock' = Amazon Bedrock (needs AWS credentials below)
MODEL_PROVIDER=ollama

# ── Ollama Config (only needed if MODEL_PROVIDER=ollama) ───
# Install Ollama from https://ollama.com  (free, runs locally)
# Then run: ollama pull llama3.2
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── AWS / Bedrock (only needed if MODEL_PROVIDER=bedrock) ──
# AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE
# AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Server Config ──────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── DynamoDB Local Config ──────────────────────────────────
# Default connects to local DynamoDB container on port 8001
# Set USE_AWS_DYNAMODB=true to switch seamlessly to real AWS DynamoDB
USE_AWS_DYNAMODB=false
DYNAMODB_ENDPOINT_URL=http://localhost:8001
